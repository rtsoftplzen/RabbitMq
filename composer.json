{
	"name": "kdyby/rabbitmq",
	"type": "library",
	"description": "Integrates php-amqplib with RabbitMq and Nette Framework",
	"keywords": ["nette", "kdyby", "rabbitmq", "rabbit", "bunny", "amqp", "messaging", "message", "queue"],
	"homepage": "http://kdyby.org",
	"license": ["MIT"],
	"authors": [
		{
			"name": "Alvaro Videla"
		},
		{
			"name": "Filip Procházka",
			"homepage": "http://filip-prochazka.com",
			"email": "filip@prochazka.su"
		}
	],
	"require": {
		"php": "^8.1",
		"nette/di": "^3.0",
		"nette/utils": "^3.0 || ^4.0",
		"php-amqplib/php-amqplib": "^3.1"
	},
	"require-dev": {
		"contributte/console": "^0.10",
		"nette/bootstrap": "^3.0",
		"latte/latte": "^2.10 || ^3.0",
		"tracy/tracy": "^2.9",
		"phpstan/phpstan": "^1.12 || ^2.0",
		"php-coveralls/php-coveralls": "^2.5",
		"nette/tester": "^2.4",
		"mockery/mockery": "^1.6",
		"php-parallel-lint/php-parallel-lint": "^1.3",
		"typo3/class-alias-loader": "^1.0",
		"nette/caching": "^3.0"
	},
	"support": {
		"email": "filip@prochazka.su",
		"issues": "https://github.com/Kdyby/RabbitMq/issues"
	},
	"autoload": {
		"psr-4": {
			"Kdyby\\RabbitMq\\": "src/Kdyby/RabbitMq"
		}
	},
	"autoload-dev": {
		"psr-4": {
			"KdybyTests\\RabbitMq\\": "tests/KdybyTests/RabbitMq"
		}
	},
	"archive": {
		"exclude": [
			"/tests",
			"/bin-docker",
			"phpstan.neon"
		]
	},

	"minimum-stability": "dev",
  	"prefer-stable": true,
	"config": {
		"allow-plugins": {
			"typo3/class-alias-loader": true
		}
	},
	"extra": {
		"branch-alias": {
			"dev-master": "1.3-dev"
		},
		"typo3/class-alias-loader": {
			"class-alias-maps": [
				"src/Kdyby/RabbitMq/DI/ClassAliasMap.php"
			]
		}
	}
}
